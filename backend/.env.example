APP_ENV=development
DEBUG=true

DB_HOST=127.0.0.1
DB_NAME=financeiro
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

ALLOWED_ORIGINS=http://127.0.0.1:5173

# Autenticação
JWT_SECRET=defina-uma-chave-segura
JWT_EXPIRES_MINUTES=60

# Flags opcionais
ENABLE_SQL_ENDPOINT=false
ENABLE_SEARCH_API=true
ENABLE_GPT_WRITE=false
READ_ONLY=false
ADMIN_TOKEN=

# Rate limiting
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_EDIT=30/minute
RATE_LIMIT_ADMIN=10/minute
RATE_LIMIT_SEARCH=60/minute
RATE_LIMIT_GLOBAL=
TRUST_PROXY=false
