# Configuração padrão para os scripts de garimpo.
# Copie para garimpo/config.yaml e ajuste conforme necessário.

data:
  input: data/input/base.xlsx
  output_dir: data/output
  # Modo de entrada: excel (planilha única), csv (arquivos por UF), auto (pergunta se CSVs existirem)
  input_mode: auto
  # Padrão de arquivos CSV por UF (se usado input_mode=csv ou auto)
  csv_pattern: data/input/Lista_imoveis_*.csv

principal:
  # Lista de UFs que devem ser buscadas no script principal
  ufs: ["GO", "SC"]
  # Nome do arquivo de saída combinado
  output_filename: "output.xlsx"
  # Quando verdadeiro, ignora imóveis já registrados no arquivo de saída
  skip_existing: true
  # Define a cada quantos registros os dados devem ser persistidos (0 = somente ao final)
  chunk_size: 0

extrajudicial:
  # Tipos de venda aceitos para coleta
  venda_tipos: ["Venda Direta", "Venda Direta Online"]
  output_filename: "output.xlsx"
  output_financiado_filename: "output_financiado.xlsx"

http:
  timeout: 5
  # Sobrescreva cabeçalhos HTTP se precisar simular navegadores específicos
  headers: {}
  # Declare cookies quando a sessão depender de autenticação
  cookies: {}

email:
  enabled: false
  smtp_server: ""
  smtp_port: 587
  use_tls: true
  username: ""
  password: ""
  from_address: ""

supabase:
  # Habilita envio dos registros para o Supabase após salvar os arquivos locais
  enabled: false
  # Preencha via variáveis de ambiente SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_KEY
  url: ""
  anon_key: ""
  service_role_key: ""
  # Tamanho do lote para upsert (0 = enviar tudo de uma vez)
  chunk_size: 500
  # Timeout e retentativas para chamadas HTTP
  timeout: 10
  retry:
    attempts: 3
    backoff_seconds: 2
  # Caminho para registrar erros de integração
  error_log: data/output/erros_supabase.csv
